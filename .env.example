# ==============================================================================
# AGNEL ARENA FUTSAL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate values prior to running the application.

# ------------------------------------------------------------------------------
# 1. REQUIRED VARIABLES (App fails to boot if missing or invalid)
# ------------------------------------------------------------------------------
# PostgreSQL Database Connection String
# Inside Docker: postgresql://postgres:postgres@postgres:5432/futsal_laravel?schema=public
# Local Dev Host: postgresql://postgres:postgres@127.0.0.1:5432/futsal_laravel?schema=public
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public

# Application Environment Mode ('development', 'staging', or 'production')
NODE_ENV=production

# Application Base Public URL (No trailing slash)
NEXT_PUBLIC_APP_URL=https://agnelarena.com

# Cryptographic Session & Cookie Secrets (Generate random 32+ character strings for production)
SESSION_SECRET=<GENERATE_32_CHAR_RANDOM_SESSION_SECRET>
COOKIE_SECRET=<GENERATE_32_CHAR_RANDOM_COOKIE_SECRET>

# Initial Super Admin Credentials (Used during initial DB bootstrap)
ADMIN_EMAIL=superadmin@agnelarenagoa.com
ADMIN_PASSWORD=<SET_STRONG_SUPER_ADMIN_PASSWORD>
ADMIN_MOBILE=+919876543210

# ------------------------------------------------------------------------------
# 2. OPTIONAL INTEGRATIONS (Features gracefully degrade if unconfigured)
# ------------------------------------------------------------------------------
# PayU Payment Gateway Credentials
PAYU_MERCHANT_KEY=<PROD_PAYU_MERCHANT_KEY>
PAYU_MERCHANT_SALT=<PROD_PAYU_MERCHANT_SALT>
PAYU_BASE_URL=https://secure.payu.in
# Restrict allowed payment modes (UPI, Debit Card, Wallets, Net Banking)
PAYU_ENFORCE_PAYMETHOD=UPI|DC|CASH|NB

# SMS & WhatsApp Provider Configuration
# Supported providers: 'aisensy', 'twilio', 'msg91', 'gupshup', or 'mock'
SMS_PROVIDER=aisensy
AISENSY_API_KEY=<PROD_AISENSY_JWT_KEY>
AISENSY_USERNAME=AITD Official
AISENSY_CAMPAIGN_NAME_OTP=agnel_arena_otp
AISENSY_CAMPAIGN_NAME_BOOKING=agnelarena_cofirm

# Resend Email Integration (Optional fallback for ticket delivery)
RESEND_API_KEY=<PROD_RESEND_API_KEY>
RESEND_FROM_EMAIL=Agnel Arena <noreply@agnelarenagoa.com>

# Sentry Error Tracking (Optional)
SENTRY_DSN=<PROD_SENTRY_DSN>

# Payment Webhook Verification Secret
PAYMENT_WEBHOOK_SECRET=<GENERATE_RANDOM_WEBHOOK_SECRET>

# ------------------------------------------------------------------------------
# 3. DEVELOPMENT ONLY VARIABLES (Ignored in production)
# ------------------------------------------------------------------------------
# Set to 'true' in Docker container to disable host port fallback
IS_DOCKER=true
PAYU_TEST_MODE=false
