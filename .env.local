# .env.local — LOCAL DEVELOPMENT & LOCAL PRODUCTION BUILD OVERRIDE
# ============================================================================
# This file is loaded by Next.js with HIGHEST PRIORITY in all environments.
# It is intentionally NOT committed to version control (listed in .gitignore).
#
# PURPOSE: Override .env.production Docker-specific DATABASE_URL when running
#          `next build` and `next start` locally (outside Docker).
#
# ARCHITECTURE:
#   LOCAL HOST  → uses 127.0.0.1:5432 (this file)
#   DOCKER HOST → uses arena-db:5432 (injected via docker-compose environment)
#
# This file is never copied into the Docker image. When running inside Docker,
# IS_DOCKER=true is set by docker-compose, and DATABASE_URL is injected by the
# compose environment block, overriding .env.production automatically.
# ============================================================================

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/futsal_laravel?schema=public
NODE_ENV=production

# Web Push (VAPID) — dev-only keypair, generated locally via
# `node -e "console.log(require('web-push').generateVAPIDKeys())"`.
# Generate a separate pair for production; never reuse this one.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BMg1kczGH2mteIIJM31sDdz1DvwIO8y19OwzGsS0cJpLWYUySiwshqJl9xYsn2zPnBEDEaMrSJj_tuAstAb_7hc
VAPID_PRIVATE_KEY=wJAmYBGMakbPYoCdLeWfKOhQOd3tyW0j__OCbD2TnTY
VAPID_SUBJECT=mailto:no-reply@aiemgoa.ac.in
