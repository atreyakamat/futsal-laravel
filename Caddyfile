# To enable production HTTPS, replace 'http://localhost' with your actual production domain
# (e.g., agnelarenagoa.com). Caddy will automatically provision Let's Encrypt certificates
# and handle HTTP -> HTTPS redirection.

http://localhost {
    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
    }

    # Reverse proxy to the Next.js app container
    reverse_proxy app:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
